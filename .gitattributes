# Line endings are load-bearing here, so they are pinned rather than left to
# each machine's `core.autocrlf`.
#
# `apps/desktop/test/mutation-control.mjs` finds the code it mutates by exact
# string match, and many of those anchors span a newline. On a Windows box
# with `core.autocrlf=true` a plain `git checkout -- <file>` rewrites that
# file CRLF, every multi-line anchor in it stops matching, and the sweep
# reports `[SKIP] ... anchor not found`. That reads like a stale mutation and
# is actually an invariant that has quietly stopped being checked. It happened
# on 2026-09-04 to three files at once.
#
# Text is LF in the repository and LF in the working tree, on every platform.
* text=auto eol=lf

# Binaries git must never touch.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary

# GitHub's language bar counts what Locust is written in, not the tools
# around it: the drive and probe scripts, design mockups, records, test
# harnesses and build scripts stay in the repository, uncounted.
_tools/** linguist-detectable=false
_smoke/** linguist-detectable=false
design/** linguist-detectable=false
docs/** linguist-documentation
apps/desktop/test/** linguist-detectable=false
apps/desktop/scripts/** linguist-detectable=false
packages/*/test/** linguist-detectable=false
