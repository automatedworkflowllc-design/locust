{
  "name": "ai-teammate-platform",
  "version": "0.0.1",
  "private": true,
  "description": "A local-first, open-source control plane for autonomous AI teammates.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @teammate/desktop exec install-electron",
    "dev": "pnpm --filter @teammate/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
